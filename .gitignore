# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …menos o exemplo, que só tem os nomes das variáveis do painel e nenhum valor.
# É a única forma de quem clona o repositório saber o que é preciso definir.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imagens
# O original da tabuleta tem 6000×6000 e 30 MB. O que vai para o site é a
# tableta-escura.webp a 1800px, gerada dele — ver public/images/README.md.
/public/images/tableta-escura.png
# O mesmo com o rolo da ementa: 3000×3375 e 12,4 MB de origem, rolo-ementa.webp
# a 1600px no site.
/public/images/pregaminho-ementa.png

# claude code
# worktrees são cópias de trabalho; skills são symlinks para instalações
# globais e ficariam quebrados noutra máquina.
.claude/worktrees/
.claude/skills/
.claude/settings.local.json
